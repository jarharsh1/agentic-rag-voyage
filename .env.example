# Copy to .env and adjust. All values have sensible defaults.

OLLAMA_HOST=http://localhost:11434
RAG_LLM_MODEL=llama3.2
RAG_EMBED_MODEL=nomic-embed-text
# Set to 1 to force the deterministic offline backend (no Ollama needed).
RAG_OFFLINE=0
# Agentic loop limits.
RAG_MAX_SUBQUERIES=3
RAG_MAX_STEPS=4
